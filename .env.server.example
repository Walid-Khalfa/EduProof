# Backend Environment Variables
PORT=3001

# Supabase
# Required: Your Supabase project URL and service role key
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE=your_supabase_service_role_key

# AI OCR
# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash-latest
GEMINI_TIMEOUT_MS=30000

# IPFS
# Required: Pinata JWT for IPFS pinning
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=gateway.pinata.cloud

# Admin
# Required for production: API key for admin access
ADMIN_API_KEY=your_admin_api_key
# Optional: comma-separated list of admin wallet addresses.
# Wallet admins must sign the message "EduProof Admin Auth: <unixSeconds>"
# (valid 5 minutes) to authenticate. A bare wallet header is NEVER accepted.
ADMIN_WALLETS=

# Blockchain (on-chain verification)
# Required for production: the index and verify endpoints validate
# transactions against the deployed contract on-chain.
# RPC_URL defaults to the CodeNut DevNet RPC if unset.
RPC_URL=https://dev-rpc.codenut.dev
# Address of the deployed EduProofCertificate contract (see contracts/interfaces/metadata.json)
CERTIFICATE_CONTRACT=0x0000000000000000000000000000000000000000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Upload limits
MAX_UPLOAD_MB=15

# Note: Copy this file to .env.server and fill in your actual values.
# Backend env vars are NOT bundled to the frontend. Never expose
# SUPABASE_SERVICE_ROLE, GEMINI_API_KEY, PINATA_JWT, or ADMIN_API_KEY
# to the browser.
