# Frontend Environment Variables
VITE_CHAIN=devnet
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
VITE_OCR_PROVIDER=gemini
VITE_API_URL=http://localhost:3001

# For production, set VITE_API_URL to your deployed backend URL, e.g.:
# VITE_API_URL=https://api.eduproof.example.com

# Note: Copy this file to .env and fill in your actual values.
# Frontend variables prefixed with VITE_ are bundled at build time and
# visible to end users. Never store secrets here.
